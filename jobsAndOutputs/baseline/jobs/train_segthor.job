#!/bin/bash
#SBATCH --job-name=train_segthor
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --gpus=1
#SBATCH --time=04:00:00
#SBATCH --output=jobsAndOutputs/baseline/outputs/train_segthor_%j.out

set -euo pipefail

PROJECT_DIR="$HOME/ai4mi_project"
DEST="results/segthor/ce"

module purge
module load 2024
module load Anaconda3/2024.06-1

# conda activate needs the shell hook in a non-interactive shell.
# set +u because conda.sh trips over unbound variables.
set +u
source "${EBROOTANACONDA3:-$CONDA_PREFIX}/etc/profile.d/conda.sh"
conda activate ai4mi
set -u

cd "$PROJECT_DIR"

echo "python : $(which python)"
nvidia-smi

[ -d data/SEGTHOR ] || { echo "data/SEGTHOR missing — run env.job first"; exit 1; }

echo "Training SEGTHOR -> $DEST"
python -O main.py --dataset SEGTHOR --mode full --epochs 25 --dest "$DEST" --gpu

echo "Plotting"
python plot.py --metric_file "$DEST/dice_val.npy" --dest "$DEST/dice_val.png" --headless
python plot.py --metric_file "$DEST/loss_tra.npy" --dest "$DEST/loss_tra.png" --headless

echo "--- done, results in $DEST ---"
ls "$DEST"
