#!/bin/bash
#SBATCH --job-name=env_setup
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --gpus=1
#SBATCH --time=01:00:00
#SBATCH --output=jobsAndOutputs/baseline/outputs/env_setup_%j.out

set -euo pipefail

PROJECT_DIR="$HOME/ai4mi_project"

module purge
module load 2024
module load Anaconda3/2024.06-1

# conda activate needs the shell hook in a non-interactive shell
# set +u because conda.sh trips over unbound variables
set +u
source "${EBROOTANACONDA3:-$CONDA_PREFIX}/etc/profile.d/conda.sh"
set -u

cd "$PROJECT_DIR"

# 1. submodules
echo "--- git submodules ---"
git submodule init
git submodule update

# 2. conda environment
echo "--- creating conda env ---"
if ! conda env list | awk '{print $1}' | grep -qx ai4mi; then
    conda create -n ai4mi python=3.11 pip -y
fi

set +u
conda activate ai4mi
set -u

echo "python  : $(which python)"
echo "version : $(python --version)"

python -m pip install --upgrade pip wheel setuptools
python -m pip install -r requirements.txt

echo "--- installed packages ---"
python -m pip list

# 3. sanity check
python - <<'PY'
import torch, numpy, nibabel, skimage, matplotlib
print("torch    :", torch.__version__, "| built for CUDA", torch.version.cuda)
print("numpy    :", numpy.__version__)
print("nibabel  :", nibabel.__version__)
print("cuda ok  :", torch.cuda.is_available())
if torch.cuda.is_available():
    print("device   :", torch.cuda.get_device_name(0))
PY

#  4. toy dataset
if [ ! -d data/TOY2 ]; then
    echo "--- building data/TOY2 ---"
    make data/TOY2
else
    echo "data/TOY2 already present, skipping."
fi

# 5. SegTHOR
if [ ! -d data/SEGTHOR ]; then
    echo "--- checksum + unzip segthor_part1.zip ---"
    sha256sum -c data/segthor_part1.sha256

    [ -d data/segthor_part1 ] || unzip -q data/segthor_part1.zip
    rm -f data/segthor_part1/.DS_STORE

    echo "--- slicing to data/SEGTHOR ---"
    rm -rf data/SEGTHOR_tmp
    python slice_segthor.py --source_dir data/segthor_part1 \
        --dest_dir data/SEGTHOR_tmp \
        --shape 256 256 --retain 5 -p 16
    mv data/SEGTHOR_tmp data/SEGTHOR
else
    echo "data/SEGTHOR already present, skipping."
fi

