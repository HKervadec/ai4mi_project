#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=08:00:00
#SBATCH --output=slurm_logs/%x_%j.out
#SBATCH --error=slurm_logs/%x_%j.err
#SBATCH --job-name=run_experiment

# Usage: sbatch scripts/run.job configs/experiments/<name>.yaml [--set key=value ...]
# Create slurm_logs/ first (mkdir -p slurm_logs): SLURM needs it before the job starts.
# Time limit: a 384x384 run takes ~4.5 h on gpu_mig, so 8 h leaves room for the cache build
# and the 3D evaluation. Shorter runs only use (and are billed for) the time they need.

set -euo pipefail

START_TIME=$(date +%s)
trap 'END_TIME=$(date +%s); echo "total elapsed time: $((END_TIME - START_TIME)) seconds"' EXIT

PROJECT_DIR="$HOME/ai_medical_imaging_group28/"
VENV_DIR="${PROJECT_DIR}/ai4mi"

module purge
module load 2025
module load Python-bundle-PyPI/2025.04-GCCcore-14.2.0
module load CUDA/12.9.1

source "${VENV_DIR}/bin/activate"
cd "${PROJECT_DIR}"

python run.py --config "$@"
# TODO: copy results/<experiment>/<run>/ (checkpoints, volumes) to the shared Snellius folder (path to agree on)

echo "done"
