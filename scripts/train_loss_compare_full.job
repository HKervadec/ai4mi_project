#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=02:00:00
#SBATCH --job-name=loss_compare
#SBATCH --output=slurm_logs/%x_%j.out
#SBATCH --error=slurm_logs/%x_%j.err

set -euo pipefail

EXPERIMENT="${1:?Usage: sbatch scripts/train_loss_compare_full.job <experiment>}"

case "${EXPERIMENT}" in
  refined_window|refined_ce_dice|refined_ce_tversky)
    ;;
  *)
    echo "Unknown experiment: ${EXPERIMENT}"
    echo "Choose: refined_window, refined_ce_dice, or refined_ce_tversky"
    exit 1
    ;;
esac

PROJECT_DIR="$HOME/ai_medical_imaging_group28"
VENV_DIR="${PROJECT_DIR}/ai4mi"

module purge
module load 2025
module load Python-bundle-PyPI/2025.04-GCCcore-14.2.0
module load CUDA/12.9.1

cd "${PROJECT_DIR}"
source "${VENV_DIR}/bin/activate"

RUN_TAG="$(git rev-parse --short HEAD)"
DEST="results/${EXPERIMENT}_seed42_e20_losscompare_${RUN_TAG}"

echo "Git commit: ${RUN_TAG}"
echo "Experiment: ${EXPERIMENT}"
echo "Results: ${DEST}"

srun python -u main.py \
  --experiment "${EXPERIMENT}" \
  --epochs 20 \
  --seed 42 \
  --gpu \
  --dest "${DEST}"
